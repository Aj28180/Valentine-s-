<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bhumika ❤️ Ankush - 2nd Anniversary Love Story</title>
<style>
body {
  margin: 0;
  font-family: 'Georgia', serif;
  color: white;
  overflow: hidden;
  height: 100vh;
  text-align: center;
  position: relative;
}

/* BACKGROUND */
.baby-pink-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #fdf2f8 0%, #fce7f3 25%, #f9a8d4 50%, #fce7f3 75%, #fdf2f8 100%);
  z-index: 0;
}

.hearts-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 2; }
.rose-petals-password { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 4; }
.rose-petals { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 3; }

/* 🌹 HIGH QUALITY ROSE PETAL FIREWORKS 🌹 */
.rose-firework {
  position: absolute;
  width: 24px;
  height: 20px;
  background: radial-gradient(ellipse 60% 70% at 30% 20%, #ff69b4 0%, #ff1493 50%, #c71585 100%);
  border-radius: 70% 0 65% 45%;
  opacity: 0;
  box-shadow: 
    0 4px 18px rgba(255, 105, 180, 0.8),
    inset 0 1px 0 rgba(255,255,255,0.3);
  transform: rotate(0deg) scale(0);
  z-index: 30;
  pointer-events: none;
}

.rose-firework::before {
  content: '';
  position: absolute;
  top: 2px;
  left: 4px;
  width: 16px;
  height: 12px;
  background: inherit;
  border-radius: 50% 20% 50% 40%;
  opacity: 0.7;
}

.rose-firework::after {
  content: '';
  position: absolute;
  bottom: -2px;
  right: 2px;
  width: 8px;
  height: 6px;
  background: rgba(255,182,193,0.9);
  border-radius: 50% 30% 50% 20%;
  opacity: 0.6;
}

@keyframes roseFireworkExplode {
  0% {
    opacity: 1;
    transform: rotate(0deg) scale(0) translate(0, 0);
  }
  10% {
    opacity: 1;
    transform: rotate(45deg) scale(1.2);
  }
  50% {
    opacity: 1;
    transform: rotate(180deg) scale(1.1);
  }
  100% {
    opacity: 0;
    transform: rotate(720deg) scale(0.3);
  }
}

.rose-firework.launch {
  animation: roseFireworkExplode 1.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

.bg-heart {
  position: absolute;
  color: rgba(255, 105, 180, 0.15);
  font-size: 25px;
  opacity: 0.1;
  animation: gentleFloat 20s infinite linear;
}
@keyframes gentleFloat {
  0% { transform: translateY(0px) rotate(0deg); opacity: 0.1; }
  50% { opacity: 0.2; }
  100% { transform: translateY(-20px) rotate(360deg); opacity: 0.1; }
}

.rose-petal-3d {
  position: absolute;
  width: 30px;
  height: 25px;
  background: radial-gradient(ellipse 60% 70% at 30% 20%, #ff69b4 0%, #ff1493 50%, #c71585 100%);
  border-radius: 70% 0 65% 45%;
  opacity: 0.9;
  box-shadow: 0 4px 18px rgba(255, 105, 180, 0.6);
  transform-style: preserve-3d;
  animation: fall3DFixed 18s linear infinite;
}
@keyframes fall3DFixed {
  0% { transform: translateY(-100px) translateZ(-30px) rotateZ(0deg) rotateX(0deg) rotateY(0deg) scale(0.6); opacity: 0; }
  8% { opacity: 0.95; }
  92% { opacity: 0.95; }
  100% { transform: translateY(calc(100vh + 100px)) translateZ(50px) rotateZ(1440deg) rotateX(720deg) rotateY(1080deg) scale(1.3); opacity: 0; }
}

.password-heart {
  position: absolute;
  color: #ff1744;
  text-shadow: 0 0 15px #ff1744;
  font-size: 18px;
  opacity: 0.8;
  animation: heartFall 15s infinite linear;
}
.password-heart.large { font-size: 32px; opacity: 1; animation-duration: 12s; }
.password-heart.medium { font-size: 22px; opacity: 0.9; animation-duration: 14s; }
.password-heart.small { font-size: 16px; opacity: 0.7; animation-duration: 16s; }
@keyframes heartFall {
  0% { transform: translateY(-100px) rotate(0deg); opacity: 0; }
  15% { opacity: 1; }
  85% { opacity: 1; }
  100% { transform: translateY(calc(100vh + 50px)) rotate(720deg); opacity: 0; }
}

.title-glow {
  font-size: clamp(28px, 8vw, 48px) !important;
  line-height: 1.1;
  background: linear-gradient(135deg, #ff69b4, #ff1744, #ff8fab);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-shadow: 0 0 20px rgba(255, 105, 180, 0.9);
  font-weight: 800;
  margin: 8px 0 12px 0 !important;
  padding: 8px;
}

.center { 
  position: absolute; 
  top: 50%; 
  left: 50%; 
  transform: translate(-50%, -50%); 
  z-index: 10; 
  width: 95%; 
  padding: 10px; 
  box-sizing: border-box; 
}

.hidden { display: none !important; }

#lock {
