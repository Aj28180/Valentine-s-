<script>
let currentScreen = 'lock';
let currentDayIndex = 0;
const dayScreens = [
  'IMG_6265Screen',
  'proposeDayScreen',
  'chocolateDayScreen',
  'teddyDayScreen',
  'promiseDayScreen',
  'hugDayScreen',
  'kissDayScreen',
  'valentineDayScreen'
];

function goHome() {
  showScreen("photoScreen");
  hidePageNav();
}

function showPageNav(backIndex, nextIndex, backText, nextText) {
  const navContainer = document.getElementById('pageNavContainer');
  const backBtn = document.getElementById('navBackBtn');
  const nextBtn = document.getElementById('navNextBtn');
  
  backBtn.textContent = backText;
  nextBtn.textContent = nextText;
  backBtn.onclick = () => showDayScreen(backIndex);
  nextBtn.onclick = () => showDayScreen(nextIndex);
  
  navContainer.style.display = 'flex';
}

function hidePageNav() {
  document.getElementById('pageNavContainer').style.display = 'none';
}

function createRoseFireworks() {
  const fireworksContainer = document.getElementById('roseFireworks');
  for(let burst = 0; burst < 12; burst++) {
    setTimeout(() => {
      for(let i = 0; i < 8; i++) {
        setTimeout(() => {
          const petal = document.createElement('div');
          petal.className = 'rose-firework';
          const centerX = window.innerWidth / 2;
          const centerY = window.innerHeight / 2;
          const angle = (burst * 30 + i * 45) * Math.PI / 180;
          const distance = 80 + Math.random() * 60;
          petal.style.left = (centerX + Math.cos(angle) * distance - 12) + 'px';
          petal.style.top = (centerY + Math.sin(angle) * distance - 10) + 'px';
          const size = 0.8 + Math.random() * 0.8;
          petal.style.width = (24 * size) + 'px';
          petal.style.height = (20 * size) + 'px';
          fireworksContainer.appendChild(petal);
          setTimeout(() => {
            petal.classList.add('launch');
            setTimeout(() => {
              if(petal.parentNode) petal.remove();
            }, 2000);
          }, 50);
        }, i * 80);
      }
    }, burst * 200);
  }
  setTimeout(() => {
    fireworksContainer.innerHTML = '';
  }, 5000);
}

function createPasswordEffects() {
  const petalsContainer = document.getElementById('rosePetalsPassword');
  const heartsContainer = document.getElementById('heartsBg');
  
  setInterval(() => {
    const petal = document.createElement('div');
    petal.className = 'rose-petal-3d';
    petal.style.left = Math.random() * 100 + '%';
    const size = 0.8 + Math.random() * 0.6;
    petal.style.width = (30 * size) + 'px';
    petal.style.height = (25 * size) + 'px';
    const duration = 14 + Math.random() * 8;
    petal.style.animationDuration = duration + 's';
    petalsContainer.appendChild(petal);
    setTimeout(() => { if (petal.parentNode) petal.remove(); }, (duration + 3) * 1000);
  }, 200);
  
  const heartSizes = ['small', 'medium', 'large'];
  setInterval(() => {
    const heart = document.createElement('div');
    heart.className = `password-heart ${heartSizes[Math.floor(Math.random() * 3)]}`;
    heart.innerHTML = '❤️';
    heart.style.left = Math.random() * 100 + '%';
    heartsContainer.appendChild(heart);
    setTimeout(() => { if (heart.parentNode) heart.remove(); }, 20000);
  }, 300);
}

function createBgHearts() {
  const bgHearts = document.getElementById('bgHearts');
  setInterval(() => {
    const heart = document.createElement('div');
    heart.className = 'bg-heart';
    heart.innerHTML = '💕';
    heart.style.left = Math.random() * 100 + '%';
    heart.style.fontSize = (20 + Math.random() * 30) + 'px';
    bgHearts.appendChild(heart);
    setTimeout(() => heart.remove(), 30000);
  }, 800);
}

function typeWriter(element, text, speed = 80, callback) {
  let i = 0;
  element.innerHTML = '';
  function type() {
    if (i < text.length) {
      element.innerHTML += text.charAt(i);
      i++;
      setTimeout(type, speed);
    } else {
      const cursor = element.nextElementSibling;
      if (cursor && cursor.classList.contains('feather-cursor')) {
        cursor.style.display = 'none';
      }
      if (callback) callback();
    }
  }
  type();
}

function hideAllScreens() {
  document.getElementById("lock").classList.add("hidden");
  document.getElementById("startScreen").classList.add("hidden");
  document.getElementById("content").classList.add("hidden");
  document.getElementById("final").classList.add("hidden");
  document.getElementById("photoScreen").classList.add("hidden");
  dayScreens.forEach(screen => document.getElementById(screen).classList.add("hidden"));
}

function showScreen(screenId) {
  hideAllScreens();
  document.getElementById(screenId).classList.remove("hidden");
  hidePageNav();
  currentScreen = screenId;
}

function showDayScreen(index) {
  if (index >= 0 && index < dayScreens.length) {
    hideAllScreens();
    document.getElementById(dayScreens[index]).classList.remove("hidden");
    currentDayIndex = index;
    
    if (index === 0) {
      showPageNav(-1, 1, '🏠 Home', 'Next ➤');
    } else if (index === dayScreens.length - 1) {
      showPageNav(6, -1, '← Back', '🏠 Home');
    } else {
      showPageNav(index - 1, index + 1, '← Back', 'Next ➤');
    }
  }
}

function unlock() {
  const p = document.getElementById("pass").value.toLowerCase().trim();
  const error = document.getElementById("error");
  const secrets = ["iloveyou", "ilovebhumika", "09052024", "06052024"];
  
  if (secrets.includes(p)) {
    createRoseFireworks();
    document.getElementById("loveSong").play().catch(e => console.log('Music ready'));
    setTimeout(() => {
      showScreen("startScreen");
    }, 1500);
  } else {
    error.textContent = "❤️ Whisper our special words... 💕";
    error.style.color = "#ff6b9d";
    error.style.fontSize = "18px";
    setTimeout(() => error.textContent = "", 3000);
  }
}

